{
  "name": "@xfqz86/dsh-usage-stats",
  "version": "0.5.1",
  "description": "DSH web plugin: token usage stats in the sidebar footer — today badge opening a tabbed panel (overview, daily trend + heatmap, per-model and per-session breakdowns with drill-down) plus DeepSeek / OpenCode Go / Z.ai quota monitoring",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xfqz86/dsh-usage-stats.git"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.3",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.7-alpha.1 <0.3.0"
  }
}
